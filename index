<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Actividad: Aprendiendo el Método Comparado</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e8eef5 100%);
            color: #2c3e50;
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        header {
            background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
        }

        header h1 {
            font-size: 2.2em;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1em;
            opacity: 0.9;
        }

        .timer {
            position: fixed;
            top: 20px;
            right: 20px;
            background: #e74c3c;
            color: white;
            padding: 15px 25px;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.2em;
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.3);
            z-index: 1000;
        }

        .content {
            padding: 40px 30px;
        }

        .section {
            display: none;
            animation: fadeIn 0.5s ease-in;
        }

        .section.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .intro-section {
            text-align: center;
            padding: 40px 20px;
        }

        .intro-section h2 {
            font-size: 1.8em;
            margin-bottom: 20px;
            color: #2c3e50;
        }

        .intro-section p {
            font-size: 1.1em;
            margin-bottom: 15px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            text-align: left;
        }

        .scenario {
            background: #f8f9fa;
            border-left: 5px solid #3498db;
            padding: 25px;
            margin: 25px 0;
            border-radius: 8px;
        }

        .scenario h3 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.3em;
        }

        .scenario-table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            margin: 15px 0;
            border-radius: 8px;
            overflow: hidden;
        }

        .scenario-table th {
            background: #34495e;
            color: white;
            padding: 12px;
            text-align: left;
            font-weight: 600;
        }

        .scenario-table td {
            padding: 12px;
            border-bottom: 1px solid #ecf0f1;
        }

        .scenario-table tr:nth-child(even) {
            background: #f8f9fa;
        }

        .scenario-table tr:hover {
            background: #e8f4f8;
        }

        .task {
            background: #e8f8f5;
            border: 2px solid #27ae60;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .task h4 {
            color: #27ae60;
            margin-bottom: 15px;
            font-size: 1.1em;
        }

        .task label {
            display: block;
            margin: 12px 0;
            cursor: pointer;
            padding: 10px;
            border-radius: 4px;
            transition: background 0.3s;
        }

        .task label:hover {
            background: rgba(39, 174, 96, 0.1);
        }

        .task input[type="radio"],
        .task input[type="checkbox"] {
            margin-right: 10px;
            cursor: pointer;
            width: 18px;
            height: 18px;
        }

        .feedback {
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
            display: none;
            animation: slideIn 0.4s ease-out;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .feedback.correct {
            background: #d4edda;
            border: 2px solid #28a745;
            color: #155724;
        }

        .feedback.incorrect {
            background: #f8d7da;
            border: 2px solid #f5c6cb;
            color: #721c24;
        }

        .feedback.show {
            display: block;
        }

        .feedback strong {
            display: block;
            margin-bottom: 10px;
            font-size: 1.1em;
        }

        .button-group {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        button {
            padding: 12px 28px;
            font-size: 1em;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-primary:hover {
            background: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

        .btn-primary:disabled {
            background: #bdc3c7;
            cursor: not-allowed;
            transform: none;
        }

        .btn-secondary {
            background: #95a5a6;
            color: white;
        }

        .btn-secondary:hover {
            background: #7f8c8d;
            transform: translateY(-2px);
        }

        .progress-bar {
            background: #ecf0f1;
            height: 8px;
            margin: 30px 0;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            background: linear-gradient(90deg, #3498db, #2980b9);
            height: 100%;
            transition: width 0.3s ease;
        }

        .method-box {
            background: #fff3cd;
            border-left: 5px solid #ffc107;
            padding: 20px;
            margin: 20px 0;
            border-radius: 8px;
        }

        .method-box h4 {
            color: #856404;
            margin-bottom: 10px;
        }

        .method-box p {
            color: #856404;
            margin-bottom: 10px;
        }

        .method-box strong {
            color: #c95f0e;
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px 0;
        }

        .comparison-card {
            background: #f8f9fa;
            border: 2px solid #dee2e6;
            padding: 20px;
            border-radius: 8px;
        }

        .comparison-card h5 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .comparison-card p {
            margin-bottom: 8px;
            font-size: 0.95em;
        }

        .comparison-card strong {
            color: #3498db;
        }

        .summary-box {
            background: #ecf0f1;
            border: 2px solid #95a5a6;
            padding: 25px;
            border-radius: 8px;
            margin: 30px 0;
        }

        .summary-box h3 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .summary-item {
            margin: 12px 0;
            padding-left: 25px;
            position: relative;
        }

        .summary-item:before {
            content: "✓";
            position: absolute;
            left: 0;
            color: #27ae60;
            font-weight: bold;
            font-size: 1.2em;
        }

        .key-concept {
            background: #e3f2fd;
            border-left: 5px solid #2196f3;
            padding: 15px;
            margin: 15px 0;
            border-radius: 4px;
            font-style: italic;
            color: #1565c0;
        }

        footer {
            background: #ecf0f1;
            padding: 20px;
            text-align: center;
            color: #7f8c8d;
            font-size: 0.9em;
        }

        @media (max-width: 768px) {
            header h1 {
                font-size: 1.5em;
            }

            .content {
                padding: 20px;
            }

            .comparison-grid {
                grid-template-columns: 1fr;
            }

            .timer {
                position: static;
                margin-bottom: 20px;
                display: inline-block;
            }
        }
    </style>
</head>
<body>

