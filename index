                        <td style="background: #d4edda;"><strong>📊 PARTICIPACIÓN CIUDADANA</strong></td>
                        <td style="background: #d4edda;"><strong style="color: #28a745;">ALTA (68%)</strong></td>
                    </tr>
                </table>
            </div>

            <!-- DELTARQUÍA -->
            <div class="scenario">
                <h3>🌍 DELTARQUÍA</h3>
                <table class="scenario-table">
                    <tr>
                        <th>Variable</th>
                        <th>Valor</th>
                    </tr>
                    <tr>
                        <td><strong>Sistema Electoral</strong></td>
                        <td>Proporcional (múltiples partidos representados)</td>
                    </tr>
