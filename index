            <!-- GAMMATÓN -->
            <div class="scenario">
                <h3>🌍 GAMMATÓN</h3>
                <table class="scenario-table">
                    <tr>
                        <th>Variable</th>
                        <th>Valor</th>
                    </tr>
                    <tr>
                        <td><strong>Sistema Electoral</strong></td>
                        <td>Mayoritario (ganador se lleva todo)</td>
                    </tr>
                    <tr>
                        <td><strong>Acceso a información pública</strong></td>
                        <td>Muy abierto (libertad de prensa, datos públicos)</td>
                    </tr>
                    <tr>
